# Godot 4+ specific ignores
.godot/
/android/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System / editor
.DS_Store
Thumbs.db
*.tmp

# Ejecutables de Godot (no van al repositorio)
*.exe

# Paquetes de recursos descargados tal cual (grandes); lo que se usa se copia a assets/third_party/
assets/third_party_raw/*
!assets/third_party_raw/LEEME.md
!assets/third_party_raw/.gdignore
